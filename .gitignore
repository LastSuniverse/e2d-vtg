# Data, features, runs, and Python artifacts are not part of the source release.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/

data/
frames/
cache/
models/
results/
runs/
outputs/
*.ckpt
*.pt
*.pth
*.npz
*.h5
